# NexiBot Environment Variables
# Copy to .env and fill in your values for VPS deployment.
# All keys are optional; NexiBot degrades gracefully when features are unconfigured.

# =============================================================================
# LLM API KEYS (at least one required for core functionality)
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# K2K FEDERATION (optional — enables inter-agent messaging)
# =============================================================================
K2K_HUB_URL=wss://hub.example.com
K2K_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIs...
K2K_DEVICE_ID=my-device-001

# =============================================================================
# CHANNEL BOT TOKENS (enable the channels you need)
# =============================================================================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
DISCORD_BOT_TOKEN=MTAxMD...
SLACK_BOT_TOKEN=xoxb-...
WHATSAPP_TOKEN=...
SIGNAL_CLI_REST_URL=http://127.0.0.1:8080
MATRIX_HOMESERVER=https://matrix.org
MATRIX_ACCESS_TOKEN=syt_...

# =============================================================================
# VOICE PROVIDERS (optional — enable speech I/O)
# =============================================================================
DEEPGRAM_API_KEY=dg_...
ELEVENLABS_API_KEY=sk_...
CARTESIA_API_KEY=...
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=eastus
GOOGLE_STT_API_KEY=...

# =============================================================================
# SEARCH / BROWSER (optional — enables web search and browsing)
# =============================================================================
SERPAPI_KEY=...
BRAVE_API_KEY=...
BING_API_KEY=...
JINA_API_KEY=...

# =============================================================================
# BRIDGE SERVICE (local — usually auto-launched, override if needed)
# =============================================================================
BRIDGE_PORT=18790
ANTHROPIC_BRIDGE_URL=http://127.0.0.1:18790
BRIDGE_PLUGINS_DIR=/opt/nexibot/bridge-plugins

# =============================================================================
# RUNTIME TUNING (optional — leave defaults if unsure)
# =============================================================================
RUST_LOG=nexibot_tauri=info
NEXIBOT_HEADLESS=0
NEXIBOT_PROFILE=default
NEXIBOT_MODEL=claude-sonnet-4
NEXIBOT_API_KEY=sk-ant-api03-...
NEXIBOT_DEFENSE_ENABLED=true
NEXIBOT_SANDBOX_ENABLED=false
NEXIBOT_GATEWAY_ENABLED=false
NEXIBOT_GATEWAY_PORT=8080

# =============================================================================
# PATH OVERRIDES (rarely needed)
# =============================================================================
# WAKEWORD_MODELS_DIR=/opt/nexibot/wakeword-models
# NEXIBOT_CONFIG_DIR=/etc/nexibot